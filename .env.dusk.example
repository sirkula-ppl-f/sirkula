# Konfigurasi khusus Laravel Dusk (tes browser).
# Salin ke .env.dusk.local, lalu isi APP_KEY dengan nilai APP_KEY dari .env kamu.
# Jangan commit .env.dusk.local. Lihat SETUP.md bagian Laravel Dusk.

APP_NAME=Sirkula
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database khusus Dusk. Isinya dikosongkan setiap kali Dusk berjalan.
# Nama harus diakhiri "_dusk", kalau tidak tes Dusk dibatalkan (lihat tests/DuskTestCase.php).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sirkula_dusk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Email hanya ditulis ke storage/logs, tidak perlu Mailpit saat Dusk.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@sirkula.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
